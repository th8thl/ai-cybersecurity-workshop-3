DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.app.github.dev
AI_PROVIDER=qwen
GEMINI_API_KEY=
# Choose a model available to your account before selecting Gemini.
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=
QWEN_MODEL=qwen3:0.6b-q4_K_M
QWEN_API_URL=http://127.0.0.1:11434/api/chat

# Inherited Session 2 rails stay enabled. Session 3 adds a retrieval flow.
NEMO_ENABLED=True
NEMO_POLICY_MODE=deterministic

# Embeddings are separate from the answer model. Never silently fall back to demo.
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_MODEL=embeddinggemma:300m
RAG_EMBEDDING_URL=http://127.0.0.1:11434/api/embed
RAG_TOP_K=3
RAG_MAX_DISTANCE=0.75
# Optional RAG_INDEX_DIR: defaults to .rag-index inside this application.
